exports[`NeedsAction markup (no failed refunds) > nothing to do 1`] = `"<section class="border-2 border-line-strong bg-surface"><div class="border-b-2 border-line-strong px-4 py-3"><h2 class="text-[15px] font-extrabold">Needs action</h2></div><p class="p-6 text-center text-[13px] text-ink-2">Nothing needs attention right now.</p></section>"`;

exports[`NeedsAction markup (no failed refunds) > overdue and unassigned 1`] = `"<section class="border-2 border-line-strong bg-surface"><div class="border-b-2 border-line-strong px-4 py-3"><h2 class="text-[15px] font-extrabold">Needs action</h2></div><div class="flex flex-col gap-3 p-4"><div><div class="mb-1.5 text-[10px] font-extrabold uppercase tracking-[0.14em] text-orange">Overdue (1)</div><ul class="flex flex-col gap-1.5"><li><a href="/bookings/bk-1" class="cl-btn flex items-center justify-between gap-2 border-l-4 border-orange bg-orange-tint px-2.5 py-1.5 text-[12px] text-orange-tint-ink hover:opacity-90"><span class="truncate">12 Test St · Pat Example</span><span class="cl-nums flex-none font-extrabold">since Nov 2</span></a></li></ul></div><div><div class="mb-1.5 text-[10px] font-extrabold uppercase tracking-[0.14em] text-ink-3">Unassigned jobs (1)</div><ul class="flex flex-col gap-1.5"><li><a href="/dispatch?sel=job-1" class="cl-btn flex items-center justify-between gap-2 border-2 border-line px-2.5 py-1.5 text-[12px] hover:border-ink"><span class="truncate"><span class="font-extrabold capitalize">delivery</span> 7 Today Rd · Lee Prepaid</span><span class="cl-nums flex-none text-ink-2">Nov 6</span></a></li></ul></div></div></section>"`;
