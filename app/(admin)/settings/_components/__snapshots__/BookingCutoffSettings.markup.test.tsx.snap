exports[`Order cutoff panel > staff, read-only 1`] = `"<section class="border-2 border-line-strong bg-surface" data-testid="booking-cutoff-panel"><div class="flex flex-wrap items-center gap-2 border-b-2 border-line-strong px-4 py-3"><span class="text-[15px] font-extrabold">Order cutoff</span><span class="px-2 py-0.5 text-[11px] font-extrabold uppercase bg-teal-tint text-teal-tint-ink">On</span></div><div class="flex flex-col gap-3 p-4"><p class="text-[13px] text-ink-2">While it&#x27;s on, online and pay-link orders placed at or after the cutoff time (Eastern) can&#x27;t choose tomorrow: the earliest delivery is the day after tomorrow. Phone bookings made here by staff can always choose tomorrow.</p><p class="text-[13px] font-semibold">On — online and pay-link orders after 5:30 PM Eastern deliver from the day after tomorrow. <span class="font-normal text-ink-3">Read-only — only an owner can change it.</span></p></div></section>"`;

exports[`Order cutoff panel > unreadable 1`] = `"<section class="border-2 border-line-strong bg-surface" data-testid="booking-cutoff-panel"><div class="flex flex-wrap items-center gap-2 border-b-2 border-line-strong px-4 py-3"><span class="text-[15px] font-extrabold">Order cutoff</span><span class="px-2 py-0.5 text-[11px] font-extrabold uppercase bg-tint text-ink-2">Off</span></div><div class="flex flex-col gap-3 p-4"><p class="text-[13px] text-ink-2">While it&#x27;s on, online and pay-link orders placed at or after the cutoff time (Eastern) can&#x27;t choose tomorrow: the earliest delivery is the day after tomorrow. Phone bookings made here by staff can always choose tomorrow.</p><p class="border-l-4 border-orange bg-orange-tint px-3 py-2 text-[12px] font-semibold text-orange-tint-ink">The order cutoff couldn&#x27;t be read just now. Until it can, bookings follow the usual rule: tomorrow or later.</p></div></section>"`;
