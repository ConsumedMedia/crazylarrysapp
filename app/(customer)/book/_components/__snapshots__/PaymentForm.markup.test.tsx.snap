exports[`/book PaymentForm markup > disabled with a reason 1`] = `"<div class="border-2 border-line-strong bg-surface"><div class="flex items-center justify-between border-b-2 border-line-strong px-4 py-3"><span class="text-[11px] font-extrabold uppercase tracking-[0.16em]">Card payment</span><span class="bg-[#2ca01c] px-2 py-1 text-[10px] font-extrabold uppercase tracking-[0.1em] text-white">QuickBooks Payments</span></div><div class="flex flex-col gap-3.5 p-4"><p class="text-[12px] text-ink-3">Card details go straight to QuickBooks Payments — they never touch Larry&#x27;s servers.</p><label class="flex flex-col gap-1.5 text-[11px] font-extrabold uppercase tracking-[0.14em] text-ink-2">Name on card<input autoComplete="cc-name" class="w-full border-2 border-line bg-bg px-3 py-2.5 text-[15px] text-ink cl-nums" value=""/></label><label class="flex flex-col gap-1.5 text-[11px] font-extrabold uppercase tracking-[0.14em] text-ink-2">Card number<input inputMode="numeric" autoComplete="cc-number" placeholder="4111 1111 1111 1111" class="w-full border-2 border-line bg-bg px-3 py-2.5 text-[15px] text-ink cl-nums" value=""/></label><div class="grid grid-cols-[1fr_1fr_1fr_1.2fr] gap-3"><label class="flex flex-col gap-1.5 text-[11px] font-extrabold uppercase tracking-[0.14em] text-ink-2">MM<input inputMode="numeric" autoComplete="cc-exp-month" placeholder="09" class="w-full border-2 border-line bg-bg px-3 py-2.5 text-[15px] text-ink cl-nums" value=""/></label><label class="flex flex-col gap-1.5 text-[11px] font-extrabold uppercase tracking-[0.14em] text-ink-2">YY<input inputMode="numeric" autoComplete="cc-exp-year" placeholder="30" class="w-full border-2 border-line bg-bg px-3 py-2.5 text-[15px] text-ink cl-nums" value=""/></label><label class="flex flex-col gap-1.5 text-[11px] font-extrabold uppercase tracking-[0.14em] text-ink-2">CVC<input inputMode="numeric" autoComplete="cc-csc" placeholder="123" class="w-full border-2 border-line bg-bg px-3 py-2.5 text-[15px] text-ink cl-nums" value=""/></label><label class="flex flex-col gap-1.5 text-[11px] font-extrabold uppercase tracking-[0.14em] text-ink-2">Billing ZIP<input inputMode="numeric" autoComplete="postal-code" placeholder="43004" class="w-full border-2 border-line bg-bg px-3 py-2.5 text-[15px] text-ink cl-nums" value=""/></label></div><button disabled="" class="mt-1 flex w-full items-center justify-between bg-teal px-4 py-4 text-[15px] font-extrabold text-white hover:bg-teal-700 disabled:opacity-50">Pay $402.05 &amp; book it<span>→</span></button><p class="text-[12px] text-ink-3">Open the agreement first.</p></div></div>"`;

